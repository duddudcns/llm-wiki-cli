{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "llmw hook userpromptsubmit || exit 0"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash|PowerShell|mcp__llm-wiki__llmw_search|mcp__llm-wiki__llmw_write|mcp__llm-wiki__llmw_edit|mcp__llm-wiki__llmw_patch|mcp__llm-wiki__llmw_archive",
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "llmw hook pretooluse || exit 0"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "llmw hook stop || exit 0"
          }
        ]
      }
    ]
  }
}
